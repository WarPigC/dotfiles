{
  "positionX": "right",
  "positionY": "top",
  "layer": "top",

  "notification-window-width": 380,

  "transition-time": 300,

  "timeout": 5,
  "timeout-low": 5,
  "timeout-critical": 5,

  "notification-2fa-action": false,

  "control-center-width": 500,
  "control-center-height": 600,
  "fit-to-screen": false,
  "hide-on-clear": false,
  "hide-on-action": true,
  "keyboard-shortcuts": true,

  "notification-visibility": {
    "antigravity-ide-by-name": {
      "state": "muted",
      "app-name": "(?i).*antigravity.*"
    },
    "antigravity-ide-by-desktop-entry": {
      "state": "muted",
      "desktop-entry": "(?i).*antigravity.*"
    }
  },

  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    }
  }
}
