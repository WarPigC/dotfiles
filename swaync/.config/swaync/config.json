{
  // Position & layer  
  "positionX": "right",
  "positionY": "top",
  "layer": "top",

  // Notification bubble width  
  "notification-window-width": 380,

  // Slide-in animation duration in ms  
  "transition-time": 300,

  // Timeouts, per urgency  (was: [urgency_*] timeout = 5)
  "timeout": 5,
  "timeout-low": 5,
  "timeout-critical": 5,

  // Removes copy feature for 2FA codes in notifications
  "notification-2fa-action": false,

  // Control center behavior 
  "control-center-width": 500,
  "control-center-height": 600,
  "fit-to-screen": false,
  "hide-on-clear": false,
  "hide-on-action": true,
  "keyboard-shortcuts": true,

  // Mute rule  
  "notification-visibility": {
    "antigravity-ide": {
      "state": "muted",
      "app-name": "Antigravity IDE"
    }
  },

  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    }
  }
}
